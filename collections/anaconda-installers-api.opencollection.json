{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anaconda Server Installers API",
    "version": "6.5"
  },
  "items": [
    {
      "info": {
        "name": "installers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of miniconda installers available for download.",

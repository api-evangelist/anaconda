{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anaconda Server Users API",
    "version": "6.5"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update user token metadata",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.anaconda.cloud/api/account/tokens/:token_id/metadata",
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path",
                "description": "Id of the token position, not an X-Auth or JWT token itself!"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates token metadata\n"
        },
        {
          "info": {
            "name": "Get user tokens for current account by admin user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.anaconda.cloud/api/users/:user_id/tokens",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the list of created token by this user, either `scope` or `resource` type. Token list includes also `token_hash`.\n"
        },
        {
          "info": {
            "name": "Create a new user token by admin user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.anaconda.cloud/api/users/:user_id/tokens",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Give access to allow user to do specific actions on one or more resources"
        },
        {
          "info": {
            "name": "Bulk update of token information for users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.anaconda.cloud/api/users/tokens",
            "params": [
              {
                "name": "with_hash",
                "value": "",
                "type": "query",
                "description": "get token endpoint by default returns token hash."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "By default reissues a new tokens and returns a UsersTokens object with tokens,  successful_updated_users and unsuccessful_updated_users attributes. If `reissue_token` query parameter is false, then tokens are not reissued and old values are used. The api returns `null` as a token in this case.\n"
        },
        {
          "info": {
            "name": "Bulk update of token information for users",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.anaconda.cloud/api/users/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "By default reissues a new tokens and returns a UsersTokens object with tokens,  successful_updated_users and unsuccessful_updated_users attributes. If `reissue_token` query parameter is false, then tokens are not reissued and old values are used. The api returns `null` as a token in this case.\n"
        },
        {
          "info": {
            "name": "Update user token information",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.anaconda.cloud/api/users/:user_id/tokens/:token_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "token_id",
                "value": "",
                "type": "path",
                "description": "Id of the token position, not an X-Auth or JWT token itself!"
              },
              {
                "name": "reissue_token",
                "value": "",
                "type": "query",
                "description": "update token endpoint by default reissues a new token."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "By default reissues a new token and returns in `token` attribute. If `reissue_token` query parameter is false, then token is not reissued and old value is used. The api returns `null` as a token in this case.\n"
        },
